{
  "images": {
    "sizes": [640],
    "formats": ["image/avif", "image/webp"],
    "remotePatterns": [
      { "protocol": "https", "hostname": "tong.visitkorea.or.kr" },
      { "protocol": "http", "hostname": "tong.visitkorea.or.kr" },
      { "protocol": "https", "hostname": "devin.aks.ac.kr" }
    ],
    "minimumCacheTTL": 86400
  },
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://oiso.duckdns.org/api/:path*"
    },
    {
      "source": "/oauth2/:path*",
      "destination": "https://oiso.duckdns.org/oauth2/:path*"
    },
    {
      "source": "/login/oauth2/:path*",
      "destination": "https://oiso.duckdns.org/login/oauth2/:path*"
    },
    {
      "source": "/tour-image-proxy/:path*",
      "destination": "https://tong.visitkorea.or.kr/:path*"
    },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
